{
  "id": "clean_docu",
  "name": "Clean Docu (history / facts)",
  "layout": "boxed",
  "bg": "#0B0B0D",
  "boxTop": 700,
  "boxHeight": 700,
  "fonts": {
    "header": "Oswald",
    "list": "Montserrat",
    "badge": "Oswald"
  },
  "colors": {
    "headerText": "#FFFFFF",
    "headerStroke": "#000000",
    "headerBg": "#E31937",
    "accent": "#E31937",
    "listText": "#FFFFFF",
    "listNumber": "#E31937",
    "badgeText": "#FFFFFF",
    "badgeStroke": "#000000",
    "badgeBg": "#E31937",
    "labelText": "#FFFFFF",
    "hookText": "#FFFFFF"
  },
  "header": {
    "style": "plain",
    "size": 92,
    "weight": 700,
    "y": 150,
    "uppercase": true,
    "tracking": 2
  },
  "list": {
    "show": true,
    "x": 40,
    "y": 1450,
    "size": 54,
    "rowHeight": 84,
    "width": 1000
  },
  "badge": {
    "style": "slam",
    "size": 200,
