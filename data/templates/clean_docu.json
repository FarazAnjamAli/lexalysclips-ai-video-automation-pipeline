    "box": true,
    "y": 40
  },
  "caption": {
    "show": false
  },
  "transition": "zoom",
  "sfx": {
    "transition": "whoosh_2",
    "reveal": "text_swoosh",
    "revealFinal": "impact_boom"
  },
  "music": "Epic_Unease.mp3",
  "musicVolume": 0.4,
  "progress": true,
  "outro": true,
  "topShade": 0.5,
  "watermark": {
    "opacity": 0.18,
    "size": 30
