# Copy to .env (or set these in ecosystem.config.js / your host) — never commit real values.

# Free key from https://console.groq.com/keys — powers AI titles/hashtags and auto-captions.
# Optional: you can also paste it in the app under Settings instead.
GROQ_API_KEY=

# Port the Express server listens on
PORT=4545

# Optional password lock for hosting (leave empty for local use)
RANKREEL_PASSWORD=
RANKREEL_SECRET=

# Optional overrides
# FFMPEG_DIR=C:\ffmpeg\bin
# COOKIES_BROWSER=chrome
# RENDER_GL=angle
# RENDER_CONCURRENCY=4
