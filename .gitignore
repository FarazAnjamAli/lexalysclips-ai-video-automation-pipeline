# dependencies
node_modules/
web/node_modules/

# Next.js build output
web/.next/
web/out/
*.tsbuildinfo
next-env.d.ts

# runtime data (your clips, projects, renders, API key) — never commit
data/*
!data/templates/
data/settings.json
data/.auth_secret

# secrets
.env
.env.*
!.env.example

# large / third-party binaries and audio (see the README in each folder)
assets/bin/*.exe
assets/music/*.mp3
assets/music/*.wav
assets/music/*.m4a
assets/sfx/*.mp3

# logs / OS
*.log
.DS_Store
Thumbs.db
